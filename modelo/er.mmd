    ROL {
        NUMBER ID_ROL PK
        VARCHAR2 NOMBRE UK
        VARCHAR2 DESCRIPCION
        NUMBER DIAS_PRESTAMO
        NUMBER MAX_PRESTAMOS
    }
    USUARIO {
        NUMBER ID_USUARIO PK
        VARCHAR2 CODIGO UK
        VARCHAR2 NOMBRES
        VARCHAR2 APELLIDOS
        VARCHAR2 CORREO UK
        VARCHAR2 TELEFONO
        VARCHAR2 DIRECCION
        DATE FECHA_REGISTRO
        CHAR ESTADO
        NUMBER ID_ROL FK
        VARCHAR2 USERNAME UK
        VARCHAR2 PASSWORD_HASH
    }
    AUTOR {
        NUMBER ID_AUTOR PK
        VARCHAR2 NOMBRES
        VARCHAR2 APELLIDOS
        VARCHAR2 NACIONALIDAD
    }
    EDITORIAL {
        NUMBER ID_EDITORIAL PK
        VARCHAR2 NOMBRE UK
        VARCHAR2 PAIS
    }
    CATEGORIA {
        NUMBER ID_CATEGORIA PK
        VARCHAR2 NOMBRE UK
        VARCHAR2 DESCRIPCION
    }
    LIBRO {
        NUMBER ID_LIBRO PK
        VARCHAR2 ISBN UK
        VARCHAR2 TITULO
        NUMBER ANIO_PUBLICACION
        VARCHAR2 EDICION
        VARCHAR2 IDIOMA
        NUMBER NUM_PAGINAS
        NUMBER ID_EDITORIAL FK
        NUMBER ID_CATEGORIA FK
        CHAR ESTADO
    }
    LIBRO_AUTOR {
        NUMBER ID_LIBRO PK, FK
        NUMBER ID_AUTOR PK, FK
    }
    EJEMPLAR {
        NUMBER ID_EJEMPLAR PK
        NUMBER ID_LIBRO FK
        VARCHAR2 CODIGO_BARRAS UK
        VARCHAR2 ESTADO
        DATE FECHA_ADQUISICION
    }
    PRESTAMO {
        NUMBER ID_PRESTAMO PK
        NUMBER ID_USUARIO FK
        NUMBER ID_EJEMPLAR FK
        NUMBER ID_BIBLIOTECARIO FK
        DATE FECHA_PRESTAMO
        DATE FECHA_DEVOLUCION_PREVISTA
        VARCHAR2 ESTADO
    }
    DEVOLUCION {
        NUMBER ID_DEVOLUCION PK
        NUMBER ID_PRESTAMO FK, UK
        DATE FECHA_DEVOLUCION_REAL
        CHAR A_TIEMPO
        NUMBER DIAS_RETRASO
        VARCHAR2 OBSERVACIONES
        NUMBER ID_BIBLIOTECARIO FK
    }
    BITACORA {
        NUMBER ID_BITACORA PK
        TIMESTAMP FECHA_HORA
        VARCHAR2 USUARIO
        VARCHAR2 TABLA
        VARCHAR2 OPERACION
        NUMBER ID_REGISTRO
        CLOB DATOS_ANTERIORES
        CLOB DATOS_NUEVOS
    }
